# Copy to .env for local development. In AWS these are injected from Secrets Manager.

# Shared
JWT_SECRET=local-dev-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Shared secret for service-to-service (internal) endpoints
INTERNAL_TOKEN=local-internal-token

# Gateway rate limiting (requests per window, per client IP)
RATE_LIMIT=120
RATE_WINDOW=1m

# Payment gateway (mock Razorpay-shaped). Swap with real keys in production.
RAZORPAY_KEY_ID=rzp_test_mockkey
RAZORPAY_KEY_SECRET=mock_key_secret
RAZORPAY_WEBHOOK_SECRET=mock_webhook_secret

# Admin bootstrap (user-service seeds this admin on first boot)
ADMIN_EMAIL=admin@avartworks.in
ADMIN_PASSWORD=admin12345

# Postgres (single instance, schema-per-service)
DATABASE_URL=postgres://avart:avart_secret@localhost:5432/avartworks?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379/0

# Service ports
USER_SERVICE_ADDR=:8081
CATALOG_SERVICE_ADDR=:8082
ORDER_SERVICE_ADDR=:8083
PAYMENT_SERVICE_ADDR=:8084
GATEWAY_ADDR=:8080
