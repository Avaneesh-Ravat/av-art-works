# Copy to .env for local development. In AWS these are injected from Secrets Manager.

# Shared
JWT_SECRET=local-dev-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Shared secret for service-to-service (internal) endpoints
INTERNAL_TOKEN=local-internal-token

# Gateway rate limiting (requests per window, per client IP)
RATE_LIMIT=120
RATE_WINDOW=1m

# Payment gateway (mock Razorpay-shaped). Swap with real keys in production.
RAZORPAY_KEY_ID=rzp_test_mockkey
RAZORPAY_KEY_SECRET=mock_key_secret
RAZORPAY_WEBHOOK_SECRET=mock_webhook_secret

# Admin bootstrap (user-service seeds this admin on first boot)
ADMIN_EMAIL=admin@avartworks.in
ADMIN_PASSWORD=admin12345

# Postgres (single instance, schema-per-service)
DATABASE_URL=postgres://avart:avart_secret@localhost:5432/avartworks?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379/0

# Service ports
USER_SERVICE_ADDR=:8081
CATALOG_SERVICE_ADDR=:8082
ORDER_SERVICE_ADDR=:8083
PAYMENT_SERVICE_ADDR=:8084
GATEWAY_ADDR=:8080

# ---------------------------------------------------------------------------
# PRODUCTION (docker-compose.prod.yml). These populate the server-side `.env`
# that the deploy pipeline writes from the GitHub secret PROD_ENV. Generate
# strong secrets (e.g. `openssl rand -base64 32`) and set your real domain.
# ---------------------------------------------------------------------------
# Postgres password used by the bundled postgres container + DATABASE_URL.
POSTGRES_PASSWORD=change-me-strong-password

# Public site origin(s) allowed by CORS. Must match your domain.
# CORS_ALLOWED_ORIGINS=https://avartworks.in,https://www.avartworks.in

# AWS S3 image storage (bucket + region from `terraform output`). No AWS keys
# here in production; the EC2 instance role provides credentials automatically.
S3_BUCKET=avartworks-images-<account-id>
AWS_REGION=ap-south-1
# Public reads stream through the API so the bucket stays private (default).
MEDIA_PUBLIC_BASE_URL=/api/v1/media
S3_PRESIGN_TTL=15m
